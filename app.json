{
  "expo": {
    "name": "Cante uma Nova Canção",
    "slug": "NovaCancao",
    "version": "3.3.50",
    "newArchEnabled": true,
    "orientation": "default",
    "icon": "./src/assets/cunc.png",
    "backgroundColor": "#000000",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "splash": {
      "image": "./src/assets/splash_logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B97D3"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/e840c608-30d7-4fde-8516-a0db43d421f5"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "userInterfaceStyle": "automatic",
      "bundleIdentifier": "br.org.icoc.novacancao",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "br.org.icoc.novacancao",
      "versionCode": 50,
      "googleServicesFile": "./google-services.json",
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID",
        "android.permission.ACCESS_ADSERVICES_AD_ID",
        "android.permission.ACCESS_ADSERVICES_ATTRIBUTION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "userInterfaceStyle": "automatic",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/cunc.png"
      }
    },
    "extra": {
      "eas": {
        "projectId": "e840c608-30d7-4fde-8516-a0db43d421f5"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "expo-web-browser",
      "@react-native-firebase/app",
      [
        "@react-native-firebase/analytics",
        {
          "ios": {
            "withoutAdIdSupport": true
          }
        }
      ],
      "./plugins/withMinimalFirebaseAnalytics.cjs",
      "./plugins/withAndroidReleaseSigning.cjs",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      "expo-asset"
    ]
  }
}
