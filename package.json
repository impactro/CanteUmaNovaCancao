{
  "name": "canteumanovacancao",
  "version": "3.3.49",
  "scripts": {
    "start": "npx expo start --dev-client",
    "android": "npm run gate:firebase && npx expo run:android --device",
    "ios": "npx expo run:ios --device",
    "web": "npx expo start --web",
    "prebuild": "npm run gate:firebase && npx expo prebuild",
    "eject": "npm run gate:firebase && npm run prebuild",
    "localhost": "npx expo start --localhost",
    "lan": "npx expo start --lan",
    "tunnel": "npx expo start --tunnel",
    "doctor": "npx expo-doctor",
    "build:android": "npm run gate:firebase && eas build --platform android",
    "build:ios": "eas device:create && eas build --platform ios",
    "build:apk": "npm run gate:firebase && eas build -p android --profile preview",
    "build:dev-android": "npm run gate:firebase && eas build --profile development --platform android",
    "prebuild:android": "npm run gate:firebase && npx expo prebuild --platform android --clean",
    "build:android-local:apk": "npm run gate:firebase && npm run prebuild:android && cd android && gradlew.bat :app:assembleRelease",
    "build:android-local:aab": "npm run gate:firebase && npm run prebuild:android && cd android && gradlew.bat :app:bundleRelease",
    "build:android-develop-apk": "npm run gate:firebase && npm run build:android-local:apk",
    "build:android-apk": "npm run gate:firebase && npm run build:android-local:aab",
    "build:dev-ios": "eas build --profile development-simulator --platform ios",
    "clean:modules": "node -e \"require('node:fs').rmSync('node_modules', { recursive: true, force: true })\"",
    "clean-module": "npm run clean:modules",
    "test:native-bootstrap": "node scripts/check-native-bootstrap.cjs",
    "test:offline-audio": "node scripts/check-offline-audio.cjs",
    "test:audio-cache": "node scripts/test-audio-cache-behavior.cjs",
    "test:music-play": "node scripts/test-music-play-analytics.cjs",
    "test:minimal-analytics": "node scripts/check-minimal-analytics.cjs",
    "test:firebase-gate": "node scripts/test-firebase-config-gate.cjs",
    "test:android-release-signing": "node scripts/test-android-release-signing.cjs",
    "gate:firebase": "node scripts/gate-firebase-config.cjs",
    "test:android-manifest": "node scripts/check-android-privacy-manifest.cjs",
    "dependencies-in-use": "npx depcheck",
    "dependecies-in-use": "npm run dependencies-in-use"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@react-native-firebase/analytics": "25.1.0",
    "@react-native-firebase/app": "25.1.0",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/stack": "^6.3.17",
    "babel-preset-expo": "~54.0.10",
    "expo": "^54.0.36",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-haptics": "~15.0.8",
    "expo-navigation-bar": "~5.0.10",
    "expo-network": "~8.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "~15.0.11",
    "qs": "^6.10.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-modalize": "^2.1.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-toast-notifications": "^3.3.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "styled-components": "6.4.4"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.1"
  },
  "private": true
}
